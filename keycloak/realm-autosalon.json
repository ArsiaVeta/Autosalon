{
  "realm": "autosalon",
  "enabled": true,
  "displayName": "Autosalon",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "accessTokenLifespan": 3600,
  "ssoSessionIdleTimeout": 7200,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      { "name": "USER", "description": "Клиент автосалона" },
      { "name": "MANAGER", "description": "Менеджер по продажам" },
      { "name": "WAREHOUSE_ADMIN", "description": "Администратор склада" },
      { "name": "ADMIN", "description": "Администратор системы" }
    ]
  },
  "clients": [
    {
      "clientId": "autosalon-app",
      "name": "Autosalon API client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "autosalon-secret",
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true,
      "redirectUris": [
        "http://localhost:*",
        "https://oauth.pstmn.io/v1/callback",
        "https://oauth.pstmn.io/v1/browser-callback"
      ],
      "webOrigins": ["*"],
      "attributes": {
        "access.token.lifespan": "3600"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ]
    }
  ],
