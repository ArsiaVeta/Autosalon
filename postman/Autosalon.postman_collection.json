{
  "info": {
    "_postman_id": "a1b2c3d4-0000-4000-8000-autosalonapi",
    "name": "Autosalon API",
    "description": "OrderService и StorageService. Токен Keycloak запрашивается автоматически перед каждым запросом, вручную его подставлять не нужно.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const isTokenRequest = pm.request.url.toString().indexOf('openid-connect/token') !== -1;",
          "if (isTokenRequest) { return; }",
          "",
          "const expiresAt = Number(pm.variables.get('token_expires_at') || 0);",
          "const token = pm.variables.get('access_token');",
          "if (token && Date.now() < expiresAt - 30000) { return; }",
          "",
          "const tokenUrl = pm.variables.replaceIn('{{keycloak_url}}/realms/{{realm}}/protocol/openid-connect/token');",
          "",
          "pm.sendRequest({",
          "    url: tokenUrl,",
          "    method: 'POST',",
          "    header: { 'Content-Type': 'application/x-www-form-urlencoded' },",
          "    body: {",
          "        mode: 'urlencoded',",
          "        urlencoded: [",
          "            { key: 'grant_type', value: 'password' },",
          "            { key: 'client_id', value: pm.variables.get('client_id') },",
          "            { key: 'client_secret', value: pm.variables.get('client_secret') },",
          "            { key: 'username', value: pm.variables.get('username') },",
          "            { key: 'password', value: pm.variables.get('password') }",
          "        ]",
          "    }",
          "}, function (err, res) {",
          "    if (err || res.code !== 200) {",
          "        console.log('TOKEN REQUEST FAILED', err || res.text());",
          "        return;",
          "    }",
          "    const data = res.json();",
          "    pm.collectionVariables.set('access_token', data.access_token);",
          "    pm.collectionVariables.set('refresh_token', data.refresh_token);",
          "    pm.collectionVariables.set('token_expires_at', Date.now() + (data.expires_in * 1000));",
          "    console.log('TOKEN OK: ' + pm.variables.get('username'));",
          "});"
        ]
      }
    }
  ],
  "variable": [
    { "key": "keycloak_url", "value": "http://localhost:8081" },
    { "key": "realm", "value": "autosalon" },
